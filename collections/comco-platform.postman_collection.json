                  "const services = Object.values(t.processes).map(p => p.serviceName);",
                  "console.log(\"Components in trace:\", services.join(\", \"), \"| spans:\", t.spans.length);",
                  "pm.test(\"one trace across coordinator, both agents and both services\", () =>",
                  "  pm.expect(services).to.include.members([\"coordinator-agent\", \"customer-agent\", \"order-agent\", \"customer-service\", \"order-service\"]));",
