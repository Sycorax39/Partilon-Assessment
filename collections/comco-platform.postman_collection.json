{
  "info": {
    "_postman_id": "673117c6-eaa4-5614-a30e-80a879ec23df",
    "name": "ComCo Integration Platform",
    "description": "API test collection for the ComCo Customer Service Integration Platform.\n\nCovers the brief's demonstration scenarios through the API gateway: REST APIs, security (401/403), rate limiting (429), the Agent API (single capability, orchestration, unknown data, A2A delegation, multi-agent coordination) and tracing in Jaeger.\n\nFailure scenarios that need containers stopped are in scripts/failure-demo.sh.\n\nRun: import into Postman / Bruno / Insomnia, or `npx newman run collections/comco-platform.postman_collection.json`.\nStart from a fresh database for exact demo values: `docker compose down -v && docker compose up --build -d`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Customer API",
      "description": "REST design: validation, status codes, one error format. Key: test-runner (full access).",
      "item": [
        {
          "name": "Get customer C001",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/C001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "C001"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"C001 is Somchai Jaidee (GOLD)\", () => { pm.expect(c.customer_id).to.eql(\"C001\"); pm.expect(c.name).to.eql(\"Somchai Jaidee\"); pm.expect(c.tier).to.eql(\"GOLD\"); });",
                  "pm.test(\"gateway added X-Correlation-ID\", () => pm.response.to.have.header(\"X-Correlation-ID\"));"
                ]
              }
            }
          ]
        },
